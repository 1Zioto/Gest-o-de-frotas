{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/gestao-frotas/browser",
  "rewrites": [
    { "source": "/api/auth/login", "destination": "/api/auth-login" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
